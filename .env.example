# Handstamp configuration. Copy to .env for local development.
# Everything here is read once at startup; restart after changes.

# ── Required ──────────────────────────────────────────────────────────────────────────────
# Postgres 17. `docker compose up db` serves this one locally.
DATABASE_URL=postgres://handstamp:handstamp@127.0.0.1:5438/handstamp

# The public origin people and apps reach Handstamp at, with no path. It is the OIDC issuer
# and the WebAuthn origin: changing it later breaks existing passkeys, so pick it once.
# Must be https:// except on localhost.
HANDSTAMP_ISSUER=http://localhost:3000

# Encrypts client secrets, signing keys and cookie keys at rest.
# Generate with: openssl rand -base64 32
# Back it up next to your database backups. Losing it means re-issuing every client secret.
HANDSTAMP_SECRET_KEY=

# ── Server ────────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
# Behind a reverse proxy (Dokploy, Traefik, Caddy): the number of proxy hops, or a
# comma-separated list of proxy IPs/CIDRs. Leave empty when Handstamp faces the internet.
TRUST_PROXY=
# Shown on the sign-in card.
HANDSTAMP_INSTANCE_NAME=Handstamp
LOG_LEVEL=info

# ── Clients ───────────────────────────────────────────────────────────────────────────────
# Optional JSON file of declared clients, synced at startup and read-only in the admin UI.
# Each client names the env var holding its secret ("secretEnv"); secrets never go in the file.
# See examples/clients.json.
HANDSTAMP_CLIENTS_FILE=

# ── Lifetimes ─────────────────────────────────────────────────────────────────────────────
SESSION_MAX_DAYS=14
REFRESH_TOKEN_DAYS=14
ACCESS_TOKEN_MINUTES=10
ID_TOKEN_MINUTES=60

# ── Signing keys ──────────────────────────────────────────────────────────────────────────
# Automatic rotation interval in days (0 turns it off; `pnpm handstamp keys rotate` still works).
KEY_ROTATION_DAYS=90
# How long a new key is published before it starts signing, so apps can cache it first.
KEY_STAGE_HOURS=24

# ── Upstream sign-in providers (optional) ─────────────────────────────────────────────────
# People can sign in with these instead of (or as well as) a passkey. Accounts are matched by the
# provider's own account id, never by email. Sign-up is closed unless ALLOW_SIGNUP=true; it can
# be limited by ALLOWED_DOMAINS (comma-separated) or, for GitHub, ALLOWED_ORGS.
# Callback URL to register at the provider: <HANDSTAMP_ISSUER>/upstream/<slug>/callback
#
# GitHub (slug: github). For GitHub Enterprise also set URL (and API_URL if not <URL>/api/v3).
HANDSTAMP_UPSTREAM_GITHUB_CLIENT_ID=
HANDSTAMP_UPSTREAM_GITHUB_CLIENT_SECRET=
HANDSTAMP_UPSTREAM_GITHUB_ALLOW_SIGNUP=false
HANDSTAMP_UPSTREAM_GITHUB_ALLOWED_ORGS=
# Google (slug: google)
HANDSTAMP_UPSTREAM_GOOGLE_CLIENT_ID=
HANDSTAMP_UPSTREAM_GOOGLE_CLIENT_SECRET=
HANDSTAMP_UPSTREAM_GOOGLE_ALLOW_SIGNUP=false
HANDSTAMP_UPSTREAM_GOOGLE_ALLOWED_DOMAINS=
# Any OIDC issuer: HANDSTAMP_UPSTREAM_OIDC_<NAME>_* (slug: <name> in lowercase, _ becomes -).
# TRUST_EMAIL=true passes the issuer's email_verified through; leave false unless you trust it.
# HANDSTAMP_UPSTREAM_OIDC_CORP_ISSUER=https://sso.example.com
# HANDSTAMP_UPSTREAM_OIDC_CORP_CLIENT_ID=
# HANDSTAMP_UPSTREAM_OIDC_CORP_CLIENT_SECRET=
# HANDSTAMP_UPSTREAM_OIDC_CORP_NAME=Corp SSO
# HANDSTAMP_UPSTREAM_OIDC_CORP_ALLOW_SIGNUP=false
# HANDSTAMP_UPSTREAM_OIDC_CORP_ALLOWED_DOMAINS=example.com
# HANDSTAMP_UPSTREAM_OIDC_CORP_TRUST_EMAIL=false

# ── Outbound calls ────────────────────────────────────────────────────────────────────────
# Handstamp calls apps' back-channel logout URIs. By default it refuses loopback and private
# addresses (SSRF protection). Set to true when your apps share a private network with it,
# e.g. other containers on the same Docker network.
ALLOW_PRIVATE_NETWORKS=false

# ── Rate limits ───────────────────────────────────────────────────────────────────────────
# Multiplies every per-IP limit (token 120/min, authorization 60/min, sign-in API 30/min).
# Keep 1 in production. Raise it only when many people share one IP.
RATE_LIMIT_SCALE=1

# ── Development only ──────────────────────────────────────────────────────────────────────
# Adds "Continue as test user" to the sign-in card. Refused unless the issuer is localhost,
# *.localhost or *.test, and refused in production unless HANDSTAMP_CONFORMANCE_MODE=1.
HANDSTAMP_DEV_LOGIN=0
HANDSTAMP_CONFORMANCE_MODE=0

# ── Local demo identity provider (pnpm example:idp), development only ─────────────────────
# HANDSTAMP_UPSTREAM_OIDC_DEMO_ISSUER=http://localhost:4100
# HANDSTAMP_UPSTREAM_OIDC_DEMO_CLIENT_ID=handstamp-dev
# HANDSTAMP_UPSTREAM_OIDC_DEMO_CLIENT_SECRET=   # any random string; the demo IdP reads it too
# HANDSTAMP_UPSTREAM_OIDC_DEMO_NAME=Demo SSO
# HANDSTAMP_UPSTREAM_OIDC_DEMO_ALLOW_SIGNUP=true
# HANDSTAMP_UPSTREAM_OIDC_DEMO_ALLOWED_DOMAINS=demo.example
# HANDSTAMP_UPSTREAM_OIDC_DEMO_TRUST_EMAIL=true
