# Spike: the Rust server (backend/), next to the Node image it may replace. See docs/RUST-PORT.md.
# Not a deployable Handstamp yet: the OIDC endpoints answer 501 until they are ported.
FROM rust:1.92-alpine AS server
RUN apk add --no-cache musl-dev
WORKDIR /app
COPY packages/db/migrations packages/db/migrations
COPY backend/Cargo.toml backend/Cargo.lock backend/build.rs backend/
COPY backend/src backend/src
RUN cargo build --release --locked --manifest-path backend/Cargo.toml

FROM node:24-alpine AS web
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN npm install --global pnpm@11.9.0
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @handstamp/web...
COPY tsconfig.base.json ./
COPY apps/web apps/web
RUN pnpm --filter @handstamp/web build

FROM alpine:3.23 AS runtime
LABEL org.opencontainers.image.title="Handstamp (Rust spike)" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="RECIAM SAS"
RUN apk add --no-cache ca-certificates \
  && addgroup -S -g 1000 handstamp && adduser -S -u 1000 -G handstamp handstamp
COPY --from=server /app/backend/target/release/handstamp-server /usr/local/bin/handstamp-server
COPY --from=web /app/apps/web/dist /app/web/dist
ENV HANDSTAMP_WEB_DIST=/app/web/dist
USER handstamp
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT:-3000}/readyz" || exit 1
CMD ["handstamp-server"]
