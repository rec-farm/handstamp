{
  "name": "handstamp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The passwordless OpenID Connect provider for the R.E.C. product family.",
  "license": "MIT",
  "author": "Rodrigo Espinosa Curbelo",
  "homepage": "https://rec.farm/handstamp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rec-farm/handstamp.git"
  },
  "bugs": "https://github.com/rec-farm/handstamp/issues",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm --filter @handstamp/web build && pnpm backend:build",
    "typecheck": "pnpm -r typecheck",
    "test": "cargo test --locked --manifest-path backend/Cargo.toml && vitest run",
    "check": "pnpm backend:check && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write . && cargo fmt --manifest-path backend/Cargo.toml",
    "format:check": "prettier --check .",
    "handstamp": "node --env-file-if-exists=.env scripts/handstamp.mjs",
    "db:migrate": "pnpm handstamp migrate",
    "e2e": "pnpm --filter @handstamp/web build && vitest run --config vitest.e2e.config.ts",
    "example": "pnpm --filter @handstamp/example-app start",
    "example:idp": "pnpm --filter @handstamp/example-app idp",
    "backend:build": "cargo build --release --locked --manifest-path backend/Cargo.toml",
    "backend:check": "cargo fmt --manifest-path backend/Cargo.toml -- --check && cargo clippy --locked --manifest-path backend/Cargo.toml --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
