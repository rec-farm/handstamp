{
  "name": "@handstamp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude '../web/**' --env-file=../../.env src/main.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/middie": "^9.3.4",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@handstamp/core": "workspace:*",
    "@handstamp/db": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "oidc-provider": "9.12.2",
    "openid-client": "6.8.8",
    "pino": "^10.4.0",
    "tsx": "^4.20.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "vite": "^8.3.2"
  }
}
